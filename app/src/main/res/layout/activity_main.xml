<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_coral"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/on_bg"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Expired subscription banner -->
        <LinearLayout
            android:id="@+id/expiredBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="24dp"
            android:background="@color/warn_bg"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscription_expired"
                android:textColor="@color/warn_fg"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/renewButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/renew_in_bot" />
        </LinearLayout>

        <!-- Link input (shown when no subscription saved) -->
        <LinearLayout
            android:id="@+id/linkInputGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/trialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/try_free"
                android:textSize="16sp"
                app:backgroundTint="@color/coral" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/or_paste_link"
                android:textColor="@color/disconnected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paste_link_title"
                android:textColor="@color/on_bg"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/paste_link_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/linkEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveLinkButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/save_link" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pairButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pair_device" />
        </LinearLayout>

        <!-- QR pairing (TV / second phone) -->
        <LinearLayout
            android:id="@+id/pairGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pair_title"
                android:textColor="@color/on_bg"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/pair_hint"
                android:textColor="@color/on_bg"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/qrImage"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="16dp"
                android:background="@color/white"
                android:padding="8dp"
                android:contentDescription="@string/pair_title" />

            <TextView
                android:id="@+id/pairCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/on_bg"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/pairStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pair_waiting"
                android:textColor="@color/disconnected"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pairCancelButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@android:string/cancel" />
        </LinearLayout>

        <!-- Connect area -->
        <LinearLayout
            android:id="@+id/connectGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="180dp"
                android:layout_height="180dp"
                app:cornerRadius="90dp"
                android:text="@string/connect"
                android:textSize="18sp"
                app:backgroundTint="@color/disconnected" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/status_disconnected"
                android:textColor="@color/on_bg"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/serverText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/on_bg"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/expiresText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_bg"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/trafficText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_bg"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/open_bot"
                app:icon="@drawable/ic_coral" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botMaxButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/open_bot_max" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeLinkButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/change_link" />
        </LinearLayout>

        <!-- Footer: in-app update + version -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/updateButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/disconnected"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
